      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="exception" expression="row1.status == null&#xD;&#xA;    ? &quot;Missing status&quot;&#xD;&#xA;    : row1.status.equals(&quot;cancelled&quot;)&#xD;&#xA;        ? &quot;Cancelled trip&quot;&#xD;&#xA;        : !row1.status.equals(&quot;completed&quot;)&#xD;&#xA;            ? &quot;Invalid status&quot;&#xD;&#xA;            : row1.start_ts == null&#xD;&#xA;                ? &quot;Missing start time&quot;&#xD;&#xA;                : row1.end_ts == null&#xD;&#xA;                    ? &quot;Missing end time&quot;&#xD;&#xA;                    : row1.end_ts.before(row1.start_ts)&#xD;&#xA;                        ? &quot;End time before start time&quot;&#xD;&#xA;                        : row1.distance_km == null&#xD;&#xA;                            ? &quot;Missing distance&quot;&#xD;&#xA;                            : row1.distance_km.doubleValue() &lt;= 0&#xD;&#xA;                                ? &quot;Invalid distance&quot;&#xD;&#xA;                                : row1.fee == null&#xD;&#xA;                                    ? &quot;Missing fee&quot;&#xD;&#xA;                                    : row1.fee.doubleValue() &lt; 0&#xD;&#xA;                                        ? &quot;Invalid fee&quot;&#xD;&#xA;                                        : null " type="id_String"/>
