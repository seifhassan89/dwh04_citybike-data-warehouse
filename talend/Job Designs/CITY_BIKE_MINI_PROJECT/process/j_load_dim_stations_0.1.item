    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;IF OBJECT_ID(N'dw.dim_stations', N'U') IS NULL&#xD;&#xA;BEGIN&#xD;&#xA;    CREATE TABLE dw.dim_stations&#xD;&#xA;    (&#xD;&#xA;        station_key&#x9;&#x9;INT IDENTITY(0,1) PRIMARY KEY,&#xD;&#xA;        station_id&#x9;&#x9;&#x9;INT NOT NULL UNIQUE,&#xD;&#xA;        station_name&#x9;&#x9;varchar(60)  NOT NULL,&#xD;&#xA;        district     &#x9;&#x9;&#x9;varchar(30)  NOT NULL,&#xD;&#xA; &#x9;&#x9;latitude     &#x9;&#x9;&#x9;numeric(9,6),&#xD;&#xA; &#x9;&#x9;longitude    &#x9;&#x9;numeric(9,6),&#xD;&#xA; &#x9;&#x9;dock_count   &#x9;&#x9;integer      NOT NULL,      -- number of bike slots at the station&#xD;&#xA; &#x9;&#x9;opened_on    &#x9;date         NOT NULL&#xD;&#xA;    );&#xD;&#xA;END;&#xD;&#xA;IF NOT EXISTS (&#xD;&#xA;    SELECT 1&#xD;&#xA;    FROM dw.dim_stations&#xD;&#xA;    WHERE station_key = 0&#xD;&#xA;)&#xD;&#xA;BEGIN&#xD;&#xA;SET IDENTITY_INSERT dw.dim_stations ON;&#xD;&#xA;INSERT INTO dw.dim_stations(&#xD;&#xA;        station_key,&#xD;&#xA;        station_id,&#xD;&#xA;        station_name,&#xD;&#xA;        district,&#xD;&#xA; &#x9;&#x9;latitude,&#xD;&#xA; &#x9;&#x9;longitude,&#xD;&#xA; &#x9;&#x9;dock_count,      -- number of bike slots at the station&#xD;&#xA; &#x9;&#x9;opened_on&#xD;&#xA;    )&#xD;&#xA;VALUES (0,0,'UNKOWN','UNKOWN',0,0,0,'1990-1-1')&#xD;&#xA;SET IDENTITY_INSERT dw.dim_stations OFF;&#xD;&#xA;END&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
