  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="320" posY="640">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER" value="JTDS"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_mssql_Server"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_mssql_Port"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="&quot;dw&quot;"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_mssql_Database"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="context.db_mssql_Login"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:61bxAI4ahXYnqeUgEqMLiu5YvXuQjTMQ3QAryp1SkQvlklO4NSkuCNpvO2D5M5zLJEfpPfE="/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;dim_stations&quot;"/>
    <elementParameter field="CHECK" name="IDENTITY_INSERT" value="false"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET XACT_ABORT ON; &quot; +&#xD;&#xA;&quot;BEGIN TRY &quot; +&#xD;&#xA;&quot;    BEGIN TRANSACTION; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 1: Validate stations */ &quot; +&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        src.station_id, &quot; +&#xD;&#xA;&quot;        src.station_name, &quot; +&#xD;&#xA;&quot;        src.district, &quot; +&#xD;&#xA;&quot;        src.latitude, &quot; +&#xD;&#xA;&quot;        src.longitude, &quot; +&#xD;&#xA;&quot;        src.dock_count, &quot; +&#xD;&#xA;&quot;        src.opened_on, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;        CASE &quot; +&#xD;&#xA;&quot;            WHEN src.station_id &lt;= 0 &quot; +&#xD;&#xA;&quot;                THEN 'Invalid station ID' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.station_name IS NULL &quot; +&#xD;&#xA;&quot;              OR LTRIM(RTRIM(src.station_name)) = '' &quot; +&#xD;&#xA;&quot;                THEN 'Missing station name' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.district IS NULL &quot; +&#xD;&#xA;&quot;              OR LTRIM(RTRIM(src.district)) = '' &quot; +&#xD;&#xA;&quot;                THEN 'Missing district' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.dock_count IS NULL &quot; +&#xD;&#xA;&quot;              OR src.dock_count &lt;= 0 &quot; +&#xD;&#xA;&quot;                THEN 'Invalid dock count' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.opened_on IS NULL &quot; +&#xD;&#xA;&quot;                THEN 'Missing opening date' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.latitude NOT BETWEEN -90 AND 90 &quot; +&#xD;&#xA;&quot;                THEN 'Invalid latitude' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.longitude NOT BETWEEN -180 AND 180 &quot; +&#xD;&#xA;&quot;                THEN 'Invalid longitude' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            ELSE NULL &quot; +&#xD;&#xA;&quot;        END AS reject_reason &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INTO #validated_stations &quot; +&#xD;&#xA;&quot;    FROM stg.stg_stations AS src; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 2: Refresh station rejects */ &quot; +&#xD;&#xA;&quot;    DELETE FROM etl.reject &quot; +&#xD;&#xA;&quot;    WHERE source_table = 'stations'; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INSERT INTO etl.reject ( &quot; +&#xD;&#xA;&quot;        source_table, business_key, reject_reason &quot; +&#xD;&#xA;&quot;    ) &quot; +&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        'stations', &quot; +&#xD;&#xA;&quot;        CONVERT(NVARCHAR(50), station_id), &quot; +&#xD;&#xA;&quot;        reject_reason &quot; +&#xD;&#xA;&quot;    FROM #validated_stations &quot; +&#xD;&#xA;&quot;    WHERE reject_reason IS NOT NULL; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 3: Upsert valid stations */ &quot; +&#xD;&#xA;&quot;    MERGE dw.dim_stations WITH (HOLDLOCK) AS tgt &quot; +&#xD;&#xA;&quot;    USING ( &quot; +&#xD;&#xA;&quot;        SELECT * &quot; +&#xD;&#xA;&quot;        FROM #validated_stations &quot; +&#xD;&#xA;&quot;        WHERE reject_reason IS NULL &quot; +&#xD;&#xA;&quot;    ) AS src &quot; +&#xD;&#xA;&quot;        ON tgt.station_id = src.station_id &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    WHEN MATCHED AND EXISTS ( &quot; +&#xD;&#xA;&quot;        SELECT &quot; +&#xD;&#xA;&quot;            tgt.station_name, &quot; +&#xD;&#xA;&quot;            tgt.district, &quot; +&#xD;&#xA;&quot;            tgt.latitude, &quot; +&#xD;&#xA;&quot;            tgt.longitude, &quot; +&#xD;&#xA;&quot;            tgt.dock_count, &quot; +&#xD;&#xA;&quot;            tgt.opened_on &quot; +&#xD;&#xA;&#xD;&#xA;&quot;        EXCEPT &quot; +&#xD;&#xA;&#xD;&#xA;&quot;        SELECT &quot; +&#xD;&#xA;&quot;            src.station_name, &quot; +&#xD;&#xA;&quot;            src.district, &quot; +&#xD;&#xA;&quot;            src.latitude, &quot; +&#xD;&#xA;&quot;            src.longitude, &quot; +&#xD;&#xA;&quot;            src.dock_count, &quot; +&#xD;&#xA;&quot;            src.opened_on &quot; +&#xD;&#xA;&quot;    ) &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    THEN UPDATE SET &quot; +&#xD;&#xA;&quot;        station_name = src.station_name, &quot; +&#xD;&#xA;&quot;        district = src.district, &quot; +&#xD;&#xA;&quot;        latitude = src.latitude, &quot; +&#xD;&#xA;&quot;        longitude = src.longitude, &quot; +&#xD;&#xA;&quot;        dock_count = src.dock_count, &quot; +&#xD;&#xA;&quot;        opened_on = src.opened_on &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    WHEN NOT MATCHED BY TARGET THEN &quot; +&#xD;&#xA;&quot;        INSERT ( &quot; +&#xD;&#xA;&quot;            station_id, &quot; +&#xD;&#xA;&quot;            station_name, &quot; +&#xD;&#xA;&quot;            district, &quot; +&#xD;&#xA;&quot;            latitude, &quot; +&#xD;&#xA;&quot;            longitude, &quot; +&#xD;&#xA;&quot;            dock_count, &quot; +&#xD;&#xA;&quot;            opened_on &quot; +&#xD;&#xA;&quot;        ) &quot; +&#xD;&#xA;&quot;        VALUES ( &quot; +&#xD;&#xA;&quot;            src.station_id, &quot; +&#xD;&#xA;&quot;            src.station_name, &quot; +&#xD;&#xA;&quot;            src.district, &quot; +&#xD;&#xA;&quot;            src.latitude, &quot; +&#xD;&#xA;&quot;            src.longitude, &quot; +&#xD;&#xA;&quot;            src.dock_count, &quot; +&#xD;&#xA;&quot;            src.opened_on &quot; +&#xD;&#xA;&quot;        ); &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    DROP TABLE #validated_stations; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    COMMIT TRANSACTION; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;END TRY &quot; +&#xD;&#xA;&quot;BEGIN CATCH &quot; +&#xD;&#xA;&quot;    IF @@TRANCOUNT > 0 &quot; +&#xD;&#xA;&quot;        ROLLBACK TRANSACTION; &quot; +&#xD;&#xA;&quot;    THROW; &quot; +&#xD;&#xA;&quot;END CATCH;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="context.db_mssql_AdditionalParams"/>
    <elementParameter field="CHECK" name="ACTIVE_DIR_AUTH" value="false" show="false"/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
