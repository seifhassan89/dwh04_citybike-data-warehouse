    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA;IF OBJECT_ID(N'dw.dim_bikes', N'U') IS NULL&#xD;&#xA;BEGIN&#xD;&#xA;    CREATE TABLE dw.dim_bikes&#xD;&#xA;    (&#xD;&#xA;        bike_key INT IDENTITY(0,1) PRIMARY KEY,&#xD;&#xA;        bike_id INT NOT NULL UNIQUE,&#xD;&#xA;        bike_code VARCHAR(12) NOT NULL UNIQUE,&#xD;&#xA;        bike_type VARCHAR(10) NOT NULL,&#xD;&#xA;        purchase_date DATE NOT NULL,&#xD;&#xA;        status_code CHAR(1) NOT NULL,&#xD;&#xA;        battery_cycles INT NULL&#xD;&#xA;    );&#xD;&#xA;&#xD;&#xA;END;&#xD;&#xA;&#xD;&#xA;IF NOT EXISTS (&#xD;&#xA;    SELECT 1&#xD;&#xA;    FROM dw.dim_bikes&#xD;&#xA;    WHERE bike_key = 0&#xD;&#xA;)&#xD;&#xA;BEGIN&#xD;&#xA;SET IDENTITY_INSERT dw.dim_bikes ON;&#xD;&#xA;INSERT INTO dw.dim_bikes (bike_key,bike_id,bike_code,bike_type,purchase_date,status_code,battery_cycles)&#xD;&#xA;VALUES (0,0,'UNKOWUN','UNKOWUN','1990-1-1', 'N',null)&#xD;&#xA;SET IDENTITY_INSERT dw.dim_bikes OFF;&#xD;&#xA;END;&#xD;&#xA;&#xD;&#xA;IF OBJECT_ID(N'stg.valid_bikes', N'U') IS NULL&#xD;&#xA;BEGIN&#xD;&#xA;    CREATE TABLE stg.valid_bikes&#xD;&#xA;    (&#xD;&#xA;        bike_id INT NOT NULL PRIMARY KEY,&#xD;&#xA;        bike_code VARCHAR(12) NOT NULL,&#xD;&#xA;        bike_type VARCHAR(10) NOT NULL,&#xD;&#xA;        purchase_date DATE NOT NULL,&#xD;&#xA;        status_code CHAR(1) NOT NULL,&#xD;&#xA;        battery_cycles INT NULL&#xD;&#xA;    );&#xD;&#xA;END&#xD;&#xA;ELSE&#xD;&#xA;BEGIN&#xD;&#xA;    TRUNCATE TABLE stg.valid_bikes;&#xD;&#xA;END;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;DELETE FROM etl.reject&#xD;&#xA;WHERE source_table = 'bikes'&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
