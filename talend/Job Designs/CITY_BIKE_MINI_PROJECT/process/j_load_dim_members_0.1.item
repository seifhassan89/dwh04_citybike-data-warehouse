    <elementParameter field="MEMO_SQL" name="QUERY" value="&#xD;&#xA;&quot;UPDATE etl.run_log &quot; +&#xD;&#xA;&quot;SET &quot; +&#xD;&#xA;&quot;    finished_at = SYSDATETIME(), &quot; +&#xD;&#xA;&quot;    status = 'SUCCESS', &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    rows_read = &quot; +&#xD;&#xA;    globalMap.get(&quot;tDBInput_1_NB_LINE&quot;) + &quot;, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    rows_loaded = &quot; +&#xD;&#xA;    globalMap.get(&quot;tDBOutput_1_NB_LINE&quot;) + &quot;, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    rows_rejected = ( &quot; +&#xD;&#xA;&quot;        SELECT COUNT(*) &quot; +&#xD;&#xA;&quot;        FROM etl.reject &quot; +&#xD;&#xA;&quot;        WHERE run_id = &quot; +&#xD;&#xA;    globalMap.get(&quot;current_run_id&quot;) +&#xD;&#xA;&quot;    ), &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    message = 'Members dimension loaded successfully' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;WHERE run_id = &quot; +&#xD;&#xA;    globalMap.get(&quot;current_run_id&quot;) +&#xD;&#xA;&quot; AND status = 'RUNNING';&quot;&#xD;&#xA;"/>
