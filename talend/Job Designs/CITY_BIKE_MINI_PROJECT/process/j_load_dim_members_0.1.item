    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:+G9niVbbCU5oprwdLzDL0JhxKBO9BM6K2xC2l92mepb7fwX+PfME3S6Ic2UVXStNWjuK9z4="/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;dim_memebers&quot;"/>
    <elementParameter field="CHECK" name="IDENTITY_INSERT" value="false"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&#xD;&#xA;&quot;IF OBJECT_ID(N'dw.dim_members', N'U') IS NULL &quot; +&#xD;&#xA;&quot;BEGIN &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    CREATE TABLE dw.dim_members ( &quot; +&#xD;&#xA;&quot;        member_key INT IDENTITY(1,1) PRIMARY KEY, &quot; +&#xD;&#xA;&quot;        member_id INT NOT NULL, &quot; +&#xD;&#xA;&quot;        full_name VARCHAR(80) NOT NULL, &quot; +&#xD;&#xA;&quot;        email VARCHAR(100), &quot; +&#xD;&#xA;&quot;        birth_date DATE, &quot; +&#xD;&#xA;&quot;        age_band VARCHAR(20), &quot; +&#xD;&#xA;&quot;        city VARCHAR(40), &quot; +&#xD;&#xA;&quot;        membership_type VARCHAR(10) NOT NULL, &quot; +&#xD;&#xA;&quot;        joined_on DATE NOT NULL, &quot; +&#xD;&#xA;&quot;        updated_at DATETIME2 NOT NULL, &quot; +&#xD;&#xA;&quot;        valid_from DATETIME2 NOT NULL, &quot; +&#xD;&#xA;&quot;        valid_to DATETIME2 NULL &quot; +&#xD;&#xA;&quot;    ); &quot; +&#xD;&#xA;&#xD;&#xA;&quot;END; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;IF NOT EXISTS ( &quot; +&#xD;&#xA;&quot;    SELECT 1 &quot; +&#xD;&#xA;&quot;    FROM dw.dim_members &quot; +&#xD;&#xA;&quot;    WHERE member_key = 0 &quot; +&#xD;&#xA;&quot;) &quot; +&#xD;&#xA;&quot;BEGIN &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SET IDENTITY_INSERT dw.dim_members ON; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INSERT INTO dw.dim_members ( &quot; +&#xD;&#xA;&quot;        member_key, member_id, full_name, email, &quot; +&#xD;&#xA;&quot;        birth_date, age_band, city, membership_type, &quot; +&#xD;&#xA;&quot;        joined_on, updated_at, valid_from, valid_to &quot; +&#xD;&#xA;&quot;    ) &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    VALUES ( &quot; +&#xD;&#xA;&quot;        0, 0, 'UNKNOWN', 'UNKNOWN', &quot; +&#xD;&#xA;&quot;        '1990-01-01', 'UNKNOWN', 'UNKNOWN', 'UNKNOWN', &quot; +&#xD;&#xA;&quot;        '1990-01-01', '1990-01-01', '1990-01-01', NULL &quot; +&#xD;&#xA;&quot;    ); &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SET IDENTITY_INSERT dw.dim_members OFF; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;END; &quot;&#xD;&#xA;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="context.db_mssql_AdditionalParams"/>
