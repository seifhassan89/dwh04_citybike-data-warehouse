  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="320" posY="640">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tDBRow_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER" value="JTDS"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_mssql_Server"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_mssql_Port"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="&quot;dw&quot;"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_mssql_Database"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="USER" value="context.db_mssql_Login"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:laW6WT2dEg8D06piTczT1OEYsKeIJlcykRj5wnAgihQePxwHyle5L0QCsIbIjB57Y/b8WkU="/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;dim_members&quot;"/>
    <elementParameter field="CHECK" name="IDENTITY_INSERT" value="false"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SET XACT_ABORT ON; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;BEGIN TRY &quot; +&#xD;&#xA;&quot;    BEGIN TRANSACTION; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    DECLARE @timeNow DATETIME2(0) = SYSDATETIME(); &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 1: Normalize and rank members */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        src.member_id, &quot; +&#xD;&#xA;&quot;        src.full_name, &quot; +&#xD;&#xA;&quot;        src.birth_date, &quot; +&#xD;&#xA;&quot;        src.city, &quot; +&#xD;&#xA;&quot;        src.membership_type, &quot; +&#xD;&#xA;&quot;        src.joined_on, &quot; +&#xD;&#xA;&quot;        src.updated_at, &quot; +&#xD;&#xA;&quot;        LOWER(REPLACE(LTRIM(RTRIM(src.email)), ' ', '')) AS email, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;CASE &quot; +&#xD;&#xA;&quot;  WHEN src.email IS NULL &quot; +&#xD;&#xA;&quot;    OR LTRIM(RTRIM(src.email)) = '' THEN 1 &quot; +&#xD;&#xA;&quot;  ELSE ROW_NUMBER() OVER ( &quot; +&#xD;&#xA;&quot;    PARTITION BY LOWER(REPLACE(LTRIM(RTRIM(src.email)), ' ', '')) &quot; +&#xD;&#xA;&quot;    ORDER BY src.member_id &quot; +&#xD;&#xA;&quot;  ) &quot; +&#xD;&#xA;&quot;END AS email_rank &quot;&#xD;&#xA;&#xD;&#xA;&quot;    INTO #ranked_members &quot; +&#xD;&#xA;&quot;    FROM stg.stg_members AS src; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 2: Validate members and calculate age band */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        src.member_id, &quot; +&#xD;&#xA;&quot;        src.full_name, &quot; +&#xD;&#xA;&quot;        src.email, &quot; +&#xD;&#xA;&quot;        src.birth_date, &quot; +&#xD;&#xA;&quot;        src.city, &quot; +&#xD;&#xA;&quot;        src.membership_type, &quot; +&#xD;&#xA;&quot;        src.joined_on, &quot; +&#xD;&#xA;&quot;        src.updated_at, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;        CASE &quot; +&#xD;&#xA;&quot;            WHEN src.birth_date IS NULL &quot; +&#xD;&#xA;&quot;              OR src.birth_date > '20250101' &quot; +&#xD;&#xA;&quot;                THEN 'Unknown' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN DATEDIFF(YEAR, src.birth_date, '20250101') &quot; +&#xD;&#xA;&quot;                 - CASE WHEN DATEADD(YEAR, &quot; +&#xD;&#xA;&quot;                     DATEDIFF(YEAR, src.birth_date, '20250101'), &quot; +&#xD;&#xA;&quot;                     src.birth_date) > '20250101' &quot; +&#xD;&#xA;&quot;                   THEN 1 ELSE 0 END &lt; 25 &quot; +&#xD;&#xA;&quot;                THEN 'Under 25' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN DATEDIFF(YEAR, src.birth_date, '20250101') &quot; +&#xD;&#xA;&quot;                 - CASE WHEN DATEADD(YEAR, &quot; +&#xD;&#xA;&quot;                     DATEDIFF(YEAR, src.birth_date, '20250101'), &quot; +&#xD;&#xA;&quot;                     src.birth_date) > '20250101' &quot; +&#xD;&#xA;&quot;                   THEN 1 ELSE 0 END &lt; 35 &quot; +&#xD;&#xA;&quot;                THEN '25-34' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN DATEDIFF(YEAR, src.birth_date, '20250101') &quot; +&#xD;&#xA;&quot;                 - CASE WHEN DATEADD(YEAR, &quot; +&#xD;&#xA;&quot;                     DATEDIFF(YEAR, src.birth_date, '20250101'), &quot; +&#xD;&#xA;&quot;                     src.birth_date) > '20250101' &quot; +&#xD;&#xA;&quot;                   THEN 1 ELSE 0 END &lt; 50 &quot; +&#xD;&#xA;&quot;                THEN '35-49' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            ELSE '50+' &quot; +&#xD;&#xA;&quot;        END AS age_band, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;        CASE &quot; +&#xD;&#xA;&quot;            WHEN src.member_id &lt;= 0 &quot; +&#xD;&#xA;&quot;                THEN 'Invalid member ID' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.email_rank > 1 &quot; +&#xD;&#xA;&quot;                THEN 'Duplicate email' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.full_name IS NULL &quot; +&#xD;&#xA;&quot;              OR LTRIM(RTRIM(src.full_name)) = '' &quot; +&#xD;&#xA;&quot;                THEN 'Missing full name' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.membership_type IS NULL &quot; +&#xD;&#xA;&quot;              OR src.membership_type NOT IN ('pay_go', 'monthly', 'annual') &quot; +&#xD;&#xA;&quot;                THEN 'Invalid membership type' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            WHEN src.joined_on IS NULL &quot; +&#xD;&#xA;&quot;                THEN 'Missing join date' &quot; +&#xD;&#xA;&#xD;&#xA;&quot;            ELSE NULL &quot; +&#xD;&#xA;&quot;        END AS reject_reason &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INTO #validated_members &quot; +&#xD;&#xA;&quot;    FROM #ranked_members AS src; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 3: Refresh member rejects */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    DELETE FROM etl.reject &quot; +&#xD;&#xA;&quot;    WHERE source_table = 'members'; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INSERT INTO etl.reject (source_table, business_key, reject_reason) &quot; +&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        'members', &quot; +&#xD;&#xA;&quot;        CONVERT(NVARCHAR(50), member_id), &quot; +&#xD;&#xA;&quot;        reject_reason &quot; +&#xD;&#xA;&quot;    FROM #validated_members &quot; +&#xD;&#xA;&quot;    WHERE reject_reason IS NOT NULL; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 4: Keep only valid members */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SELECT * &quot; +&#xD;&#xA;&quot;    INTO #valid_members &quot; +&#xD;&#xA;&quot;    FROM #validated_members &quot; +&#xD;&#xA;&quot;    WHERE reject_reason IS NULL; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 5: Apply SCD Type 1 to ALL historical versions */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    UPDATE tgt &quot; +&#xD;&#xA;&quot;    SET &quot; +&#xD;&#xA;&quot;        tgt.full_name = src.full_name, &quot; +&#xD;&#xA;&quot;        tgt.email = src.email, &quot; +&#xD;&#xA;&quot;        tgt.birth_date = src.birth_date, &quot; +&#xD;&#xA;&quot;        tgt.city = src.city, &quot; +&#xD;&#xA;&quot;        tgt.joined_on = src.joined_on, &quot; +&#xD;&#xA;&quot;        tgt.updated_at = src.updated_at, &quot; +&#xD;&#xA;&quot;        tgt.age_band = src.age_band &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    FROM dw.dim_members AS tgt &quot; +&#xD;&#xA;&quot;    INNER JOIN #valid_members AS src &quot; +&#xD;&#xA;&quot;        ON tgt.member_id = src.member_id &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    WHERE EXISTS ( &quot; +&#xD;&#xA;&quot;        SELECT tgt.full_name, tgt.email, tgt.birth_date, &quot; +&#xD;&#xA;&quot;               tgt.city, tgt.joined_on, tgt.updated_at, tgt.age_band &quot; +&#xD;&#xA;&quot;        EXCEPT &quot; +&#xD;&#xA;&quot;        SELECT src.full_name, src.email, src.birth_date, &quot; +&#xD;&#xA;&quot;               src.city, src.joined_on, src.updated_at, src.age_band &quot; +&#xD;&#xA;&quot;    ); &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 6: Find members whose plan changed */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SELECT src.* &quot; +&#xD;&#xA;&quot;    INTO #plan_changes &quot; +&#xD;&#xA;&quot;    FROM #valid_members AS src &quot; +&#xD;&#xA;&quot;    INNER JOIN dw.dim_members AS tgt &quot; +&#xD;&#xA;&quot;        ON tgt.member_id = src.member_id &quot; +&#xD;&#xA;&quot;       AND tgt.valid_to IS NULL &quot; +&#xD;&#xA;&quot;    WHERE tgt.membership_type &lt;> src.membership_type; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* Ensure history periods remain valid */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    IF EXISTS ( &quot; +&#xD;&#xA;&quot;        SELECT 1 &quot; +&#xD;&#xA;&quot;        FROM #plan_changes AS src &quot; +&#xD;&#xA;&quot;        INNER JOIN dw.dim_members AS tgt &quot; +&#xD;&#xA;&quot;            ON tgt.member_id = src.member_id &quot; +&#xD;&#xA;&quot;           AND tgt.valid_to IS NULL &quot; +&#xD;&#xA;&quot;        WHERE tgt.valid_from >= @timeNow &quot; +&#xD;&#xA;&quot;    ) &quot; +&#xD;&#xA;&quot;        THROW 51001, 'Invalid timeNow date for plan change', 1; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 7: Close old plan versions */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    UPDATE tgt &quot; +&#xD;&#xA;&quot;    SET tgt.valid_to = @timeNow &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    FROM dw.dim_members AS tgt &quot; +&#xD;&#xA;&quot;    INNER JOIN #plan_changes AS src &quot; +&#xD;&#xA;&quot;        ON tgt.member_id = src.member_id &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    WHERE tgt.valid_to IS NULL; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 8: Insert new plan versions */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INSERT INTO dw.dim_members ( &quot; +&#xD;&#xA;&quot;        member_id, full_name, email, birth_date, city, &quot; +&#xD;&#xA;&quot;        membership_type, joined_on, updated_at, age_band, &quot; +&#xD;&#xA;&quot;        valid_from, valid_to &quot; +&#xD;&#xA;&quot;    ) &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        member_id, full_name, email, birth_date, city, &quot; +&#xD;&#xA;&quot;        membership_type, joined_on, updated_at, age_band, &quot; +&#xD;&#xA;&quot;        @timeNow, NULL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    FROM #plan_changes; &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    /* STEP 9: Insert brand-new members */ &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    INSERT INTO dw.dim_members ( &quot; +&#xD;&#xA;&quot;        member_id, full_name, email, birth_date, city, &quot; +&#xD;&#xA;&quot;        membership_type, joined_on, updated_at, age_band, &quot; +&#xD;&#xA;&quot;        valid_from, valid_to &quot; +&#xD;&#xA;&quot;    ) &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    SELECT &quot; +&#xD;&#xA;&quot;        src.member_id, src.full_name, src.email, &quot; +&#xD;&#xA;&quot;        src.birth_date, src.city, src.membership_type, &quot; +&#xD;&#xA;&quot;        src.joined_on, src.updated_at, src.age_band, &quot; +&#xD;&#xA;&quot;        src.joined_on, NULL &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    FROM #valid_members AS src &quot; +&#xD;&#xA;&quot;    WHERE NOT EXISTS ( &quot; +&#xD;&#xA;&quot;        SELECT 1 &quot; +&#xD;&#xA;&quot;        FROM dw.dim_members AS tgt WITH (UPDLOCK, HOLDLOCK) &quot; +&#xD;&#xA;&quot;        WHERE tgt.member_id = src.member_id &quot; +&#xD;&#xA;&quot;    ); &quot; +&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&quot;    DROP TABLE #plan_changes; &quot; +&#xD;&#xA;&quot;    DROP TABLE #valid_members; &quot; +&#xD;&#xA;&quot;    DROP TABLE #validated_members; &quot; +&#xD;&#xA;&quot;    DROP TABLE #ranked_members; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;    COMMIT TRANSACTION; &quot; +&#xD;&#xA;&#xD;&#xA;&quot;END TRY &quot; +&#xD;&#xA;&#xD;&#xA;&quot;BEGIN CATCH &quot; +&#xD;&#xA;&quot;    IF @@TRANCOUNT > 0 &quot; +&#xD;&#xA;&quot;        ROLLBACK TRANSACTION; &quot; +&#xD;&#xA;&quot;    THROW; &quot; +&#xD;&#xA;&quot;END CATCH;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
